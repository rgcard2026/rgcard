# Local development database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-this-secret-in-production"
SESSION_SECRET="change-this-secret-in-production"
DATA_ENCRYPTION_SECRET="change-this-32-byte-data-secret"
NEXT_PUBLIC_WHATSAPP_NUMBER="201000033494"
NEXT_PUBLIC_ENABLE_LOGIN_ENCRYPTION="false"
LOGIN_MAX_FAILED_ATTEMPTS="3"
LOGIN_TEMP_BLOCK_MINUTES="15"
SESSION_MINUTES="60"

# Railway production values (create these in Railway Variables)
# DATABASE_URL="file:/data/rg-card.db"
# RG_CARD_DATA_DIR="/data"
# RG_CARD_DB_PATH="/data/rg-card.db"
# RG_CARD_UPLOADS_PATH="/data/uploads"

# Optional: environment override for security alerts. Leave blank to configure the webhook securely from Admin → Security Alerts.
# SECURITY_ALERT_WEBHOOK_URL="https://your-webhook.example/endpoint"
# SECURITY_ALERT_WEBHOOK_TOKEN=""
SECURITY_ALERT_TIMEOUT_MS="6000"
TZ="Africa/Cairo"

# Public URL used in member QR codes and generated card PDFs.
# Railway's internal 0.0.0.0:8080 address must never be used here.
RG_CARD_PUBLIC_URL="https://rg-card-web-production-9ece.up.railway.app"

# Optional: email delivery for security alerts (Resend API).
# Keep API keys only in Railway Variables — never place them in browser code or the Admin dashboard.
# RESEND_API_KEY="re_xxxxxxxxx"
# SECURITY_ALERT_EMAIL_FROM="RG-Card Security <alerts@your-verified-domain.com>"
# SECURITY_ALERT_EMAIL_TO="security@example.com,owner@example.com"
